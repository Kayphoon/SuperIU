# =============================================================================
# SuperIU — environment configuration
# =============================================================================
# Copy to `.env` and fill in your credentials:
#
#     cp .env.example .env
#
# Loaded by @agent/core via dotenv when the runner is constructed, so every
# shell (cli / ui / desktop) reads the same configuration. Values already
# present in the real environment win over `.env`.
#
# Every variable the code actually reads is listed below. Anything not set
# falls back to the default shown.
# =============================================================================


# --- Endpoint ---------------------------------------------------------------
# Any OpenAI-compatible API. Works with OpenAI, DeepSeek, SiliconFlow,
# Ollama, Moonshot, and similar.

# API credential for the endpoint above.
# Default: 'placeholder-key' (requests will fail, but the process still boots).
OPENAI_API_KEY=your_api_key_here

# Base URL of the endpoint, including the version segment.
# Default: the OpenAI SDK's own default.
# Examples: https://api.openai.com/v1 · https://api.deepseek.com/v1
#           http://localhost:11434/v1 (Ollama)
OPENAI_BASE_URL=https://api.openai.com/v1


# --- Models -----------------------------------------------------------------
# Models are routed per role. The main model drives the agent loop; every other
# role is auxiliary work that can run on something cheaper. A role with no
# variable set falls back to the default route (the main model).

# Main agent loop model.
# Default: gpt-4o
OPENAI_MODEL_NAME=gpt-4o

# AutoReview model — arbitrates tool calls the rule engine cannot decide.
# Never reuses the main model's caller, so review steps cannot consume the
# main loop's step sequence. Falls back to OPENAI_MODEL_NAME, then gpt-4o-mini.
# Default: OPENAI_MODEL_NAME, else gpt-4o-mini
OPENAI_REVIEW_MODEL_NAME=gpt-4o-mini

# Memory synthesis model — mines the conversation for durable facts on /memory.
# Default: the default route (main model).
OPENAI_MEMORY_MODEL_NAME=

# Session titling model.
# Registers the `title` route. No consumer generates titles automatically yet
# (sessions default to 'Initial Session'), so setting this has no effect today.
# Default: the default route (main model).
OPENAI_TITLE_MODEL_NAME=

# Reasoning effort for thinking models, sent to the provider as
# `reasoning_effort`. Higher effort reasons for longer and raises the output
# budget that effort needs (low 2048 · medium 4096 · high 8192, capped 16384).
#
# Only applied to models that accept the parameter (o-series other than
# o1-mini/o1-preview, and gpt-5 and later). Non-reasoning models such as gpt-4o
# are left untouched, because the provider rejects the parameter for them with
# an HTTP 400. This is what makes the thinking fold appear in the console on a
# reasoning model without breaking a gpt-4o setup.
#
# Allowed: low | medium | high. Any other value is ignored and the default is
# used instead. A per-role override (setModel with reasoningEffort) always wins.
# Default: medium
OPENAI_REASONING_EFFORT=medium


# --- Review / approval gate -------------------------------------------------

# Master switch for the automatic approval gate.
# 1 = on, 0 = off. Any value other than '0' means on.
# With the gate off, tools run without review and no approval card appears.
# Default: 1
SUPERIU_AUTO_REVIEW=1

# How the gate treats risky tool calls.
#   lenient — low/medium risk auto-allowed, high/critical escalated to you
#   strict  — everything escalated to you
# Any value other than 'strict' resolves to lenient.
# Default: lenient
SUPERIU_AUTO_REVIEW_MODE=lenient


# --- Web console (@agent/ui) -------------------------------------------------
# Ignored by the cli and desktop shells.

# HTTP port for the local web console.
# Default: 3000
PORT=3000

# Bind address. Keep this on loopback unless you intend to expose the console —
# it has no authentication and can run arbitrary shell commands through the agent.
# Default: 127.0.0.1
HOST=127.0.0.1
